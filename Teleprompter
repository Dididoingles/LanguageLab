<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Language Lab - Speaking Teleprompter</title>
    
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600&display=swap" rel="stylesheet">
    
    <style>
        :root {
            --primary-red: #c20000;
            --success-green: #2ecc71;
            --error-red: #e74c3c;
            --glass-bg: rgba(15, 15, 15, 0.85);
            --text-main: #ffffff;
            --text-dim: rgba(255, 255, 255, 0.4);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Poppins', sans-serif;
            background-color: #000;
            color: var(--text-main);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            align-items: center;
            overflow: hidden;
        }

        .bg-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-image: url('https://github.com/Dididoingles/LanguageLab/raw/c88825f499c1dc36af5b8845369ed8e925eca860/backgroundll');
            background-size: cover;
            background-position: center;
            filter: blur(12px) brightness(0.2);
            z-index: -1;
            transform: scale(1.1);
        }

        .container {
            width: 100%;
            max-width: 1000px;
            padding: 40px 20px;
            z-index: 1;
            height: 100vh;
            display: flex;
            flex-direction: column;
        }

        header {
            text-align: center;
            margin-bottom: 20px;
        }

        header h1 {
            font-weight: 600;
            font-size: 1.8rem;
            color: var(--text-main);
            letter-spacing: 1px;
        }

        /* Área de Setup */
        #setup-area {
            flex: 1;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 25px;
        }

        textarea {
            width: 100%;
            max-width: 700px;
            height: 180px;
            background: var(--glass-bg);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 20px;
            padding: 20px;
            color: white;
            font-family: inherit;
            font-size: 1.1rem;
            resize: none;
            outline: none;
            box-shadow: 0 10px 30px rgba(0,0,0,0.5);
        }

        /* Botão Estilo Welcome Page */
        .glass-btn {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            width: 180px;
            height: 180px;
            background: rgba(255, 255, 255, 0.08);
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
            color: white;
            border-radius: 25px;
            font-weight: 600;
            font-size: 1rem;
            cursor: pointer;
            transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            border: 1px solid rgba(255, 255, 255, 0.1);
            text-align: center;
            box-shadow: 0 10px 20px rgba(0,0,0,0.3);
            padding: 20px;
        }

        .glass-btn span.icon {
            font-size: 2.8rem;
            margin-bottom: 10px;
            display: block;
        }

        .glass-btn:hover {
            background-color: var(--primary-red);
            border-color: var(--primary-red);
            transform: translateY(-8px);
            box-shadow: 0 15px 35px rgba(194, 0, 0, 0.5);
        }

        /* Botões de Controle */
        .secondary-btn {
            padding: 12px 25px;
            background: rgba(255, 255, 255, 0.08);
            backdrop-filter: blur(5px);
            border: 1px solid rgba(255, 255, 255, 0.2);
            color: white;
            border-radius: 50px;
            cursor: pointer;
            font-weight: 500;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .secondary-btn:hover {
            background: rgba(255, 255, 255, 0.2);
            transform: translateY(-2px);
        }

        .btn-stop { border-color: var(--primary-red); color: var(--primary-red); }

        /* Teleprompter Layout */
        #teleprompter-area {
            display: none;
            flex-direction: column;
            height: 100%;
            padding-bottom: 40px;
        }

        .stats-bar {
            display: flex;
            justify-content: space-around;
            background: var(--glass-bg);
            padding: 15px;
            border-radius: 20px;
            margin-bottom: 20px;
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

        .stat-item { text-align: center; }
        .stat-value { display: block; font-size: 1.3rem; font-weight: 600; color: var(--primary-red); }
        .stat-label { font-size: 0.8rem; color: var(--text-dim); text-transform: uppercase; }

        #display-container {
            flex: 1;
            overflow-y: auto;
            padding: 150px 0;
            scroll-behavior: smooth;
            mask-image: linear-gradient(to bottom, transparent, black 30%, black 70%, transparent);
            -webkit-mask-image: linear-gradient(to bottom, transparent, black 30%, black 70%, transparent);
        }

        #display-text {
            font-size: 3rem;
            line-height: 1.6;
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 15px;
            padding: 0 60px;
        }

        .word { color: var(--text-dim); transition: all 0.2s ease; position: relative; }
        .word.correct { color: var(--success-green); text-shadow: 0 0 15px rgba(46, 204, 113, 0.5); }
        .word.error { color: var(--error-red); text-shadow: 0 0 15px rgba(231, 76, 60, 0.5); }
        .word.current { color: var(--text-main); transform: scale(1.1); font-weight: 600; }
        .word.current::after {
            content: '';
            position: absolute;
            bottom: -5px;
            left: 0;
            width: 100%;
            height: 3px;
            background: var(--primary-red);
            border-radius: 2px;
        }

        .footer-controls {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 20px;
            margin-top: 20px;
        }

        /* INDICADOR DE MICROFONE - CORREÇÃO DA ANIMAÇÃO */
        .mic-indicator {
            width: 80px;
            height: 80px;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.1);
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            font-size: 0.7rem;
            border: 1px solid rgba(255, 255, 255, 0.2);
            transition: all 0.3s ease;
        }

        /* ESTADO ATIVO DO BOTÃO - PISCANDO COM GLOW */
        .mic-indicator.active {
            background-color: var(--primary-red);
            border-color: var(--primary-red);
            animation: pulse-glow-red 1.5s infinite ease-in-out;
            color: white;
        }

        @keyframes pulse-glow-red {
            0% { 
                box-shadow: 0 0 10px rgba(194, 0, 0, 0.4); 
                transform: scale(1);
            }
            50% { 
                box-shadow: 0 0 30px rgba(194, 0, 0, 0.9); 
                transform: scale(1.05);
            }
            100% { 
                box-shadow: 0 0 10px rgba(194, 0, 0, 0.4); 
                transform: scale(1);
            }
        }

        ::-webkit-scrollbar { display: none; }
    </style>
</head>
<body>

    <div class="bg-overlay"></div>

    <div class="container">
        <header>
            <h1>Speaking Lab</h1>
        </header>

        <!-- SETUP -->
        <div id="setup-area">
            <textarea id="input-text" placeholder="Cole o texto em inglês que você deseja praticar..."></textarea>
            
            <button class="glass-btn" onclick="startTeleprompter()">
                <span class="icon">🎙️</span>
                
            </button>
        </div>

        <!-- TELEPROMPTER -->
        <div id="teleprompter-area">
            <div class="stats-bar">
                <div class="stat-item">
                    <span class="stat-value" id="timer">00:00</span>
                    <span class="stat-label">Tempo</span>
                </div>
                <div class="stat-item">
                    <span class="stat-value" id="accuracy">0%</span>
                    <span class="stat-label">Precisão</span>
                </div>
            </div>

            <div id="display-container">
                <div id="display-text"></div>
            </div>

            <div class="footer-controls">
                <button id="pause-btn" class="secondary-btn" onclick="togglePause()">
                    <span id="pause-icon"></span> <span id="pause-text">Pausar</span>
                </button>
                
                <div id="active-mic" class="mic-indicator active">
                    <span style="font-size: 1.5rem;">🎤</span>
                    <small id="mic-status">Ouvindo</small>
                </div>

                <button class="secondary-btn" onclick="resetTeleprompter()">
                    <span></span> Reiniciar
                </button>

                <button id="finish-btn" class="secondary-btn btn-stop" onclick="finishSession()">
                    <span></span> Finalizar
                </button>
            </div>
        </div>
    </div>

    <script>
        let recognition;
        let words = [];
        let currentWordIndex = 0;
        let correctCount = 0;
        let elapsedTime = 0;
        let timerInterval;
        let isRecording = false;
        let isPaused = false;

        if ('webkitSpeechRecognition' in window) {
            recognition = new webkitSpeechRecognition();
            recognition.continuous = true;
            recognition.interimResults = true;
            recognition.lang = 'en-US';

            recognition.onresult = (event) => {
                if (isPaused) return;

                let transcript = '';
                for (let i = event.resultIndex; i < event.results.length; ++i) {
                    transcript += event.results[i][0].transcript.toLowerCase();
                }
                
                processTranscriptInRealTime(transcript);
            };

            recognition.onend = () => {
                if (isRecording && !isPaused) recognition.start();
            };
        }

        function startTeleprompter() {
            const text = document.getElementById('input-text').value.trim();
            if (!text) return;

            words = text.split(/\s+/);
            const displayText = document.getElementById('display-text');
            displayText.innerHTML = words.map((word, index) => 
                `<span class="word" id="word-${index}">${word}</span>`
            ).join('');

            document.getElementById('setup-area').style.display = 'none';
            document.getElementById('teleprompter-area').style.display = 'flex';
            
            currentWordIndex = 0;
            correctCount = 0;
            elapsedTime = 0;
            isRecording = true;
            isPaused = false;
            
            updateWordStyles();
            startTimer();
            recognition.start();
        }

        function processTranscriptInRealTime(transcript) {
            const spokenWords = transcript.trim().split(/\s+/);
            
            spokenWords.forEach(spoken => {
                if (currentWordIndex >= words.length) return;

                const targetWord = words[currentWordIndex].toLowerCase().replace(/[.,!?;:]/g, "");
                const cleanedSpoken = spoken.replace(/[.,!?;:]/g, "");

                if (cleanedSpoken === targetWord) {
                    const wordEl = document.getElementById(`word-${currentWordIndex}`);
                    if (wordEl && !wordEl.classList.contains('correct')) {
                        wordEl.classList.add('correct');
                        wordEl.classList.remove('current', 'error');
                        correctCount++;
                        advanceWord();
                    }
                } 
            });
        }

        function advanceWord() {
            currentWordIndex++;
            updateWordStyles();
            updateAccuracy();
            
            const nextEl = document.getElementById(`word-${currentWordIndex}`);
            if (nextEl) {
                nextEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
            }

            if (currentWordIndex >= words.length) {
                finishSession();
            }
        }

        function togglePause() {
            if (isPaused) {
                isPaused = false;
                isRecording = true;
                recognition.start();
                startTimer();
                document.getElementById('pause-icon').innerText = '⏸️';
                document.getElementById('pause-text').innerText = 'Pausar';
                document.getElementById('active-mic').classList.add('active');
                document.getElementById('mic-status').innerText = 'Ouvindo';
            } else {
                isPaused = true;
                isRecording = false;
                recognition.stop();
                clearInterval(timerInterval);
                document.getElementById('pause-icon').innerText = '▶️';
                document.getElementById('pause-text').innerText = 'Continuar';
                document.getElementById('active-mic').classList.remove('active');
                document.getElementById('mic-status').innerText = 'Pausado';
            }
        }

        function updateWordStyles() {
            document.querySelectorAll('.word').forEach(el => el.classList.remove('current'));
            if (currentWordIndex < words.length) {
                const currentEl = document.getElementById(`word-${currentWordIndex}`);
                if (currentEl) currentEl.classList.add('current');
            }
        }

        function updateAccuracy() {
            const percentage = Math.round((correctCount / (currentWordIndex || 1)) * 100);
            document.getElementById('accuracy').innerText = percentage + '%';
        }

        function startTimer() {
            const timerBase = Date.now() - elapsedTime;
            timerInterval = setInterval(() => {
                elapsedTime = Date.now() - timerBase;
                const minutes = Math.floor(elapsedTime / 60000);
                const seconds = Math.floor((elapsedTime % 60000) / 1000);
                document.getElementById('timer').innerText = 
                    `${minutes.toString().padStart(2, '0')}:${seconds.toString().padStart(2, '0')}`;
            }, 1000);
        }

        function finishSession() {
            isRecording = false;
            recognition.stop();
            clearInterval(timerInterval);
            document.getElementById('active-mic').classList.remove('active');
            document.getElementById('active-mic').innerHTML = '<span style="font-size: 1.5rem;">✅</span>Fim';
            document.getElementById('pause-btn').style.display = 'none';
        }

        function resetTeleprompter() {
            location.reload();
        }
    </script>
</body>
</html>
